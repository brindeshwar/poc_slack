# socket (single workspace, no public URL) or http (multi-workspace OAuth)
SLACK_MODE=socket

# Socket mode
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# HTTP mode
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
HOST=127.0.0.1
PORT=3000

# Meeting hub (poc_mcp) MCP endpoint
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high
GEMINI_THINKING_LEVEL=low
